#!/usr/bin/env bash

# Build the system configuration (nix/nixos/default.nix), printing the
# built closure's store path on stdout; optionally run a nixos-rebuild
# action:
#   ./nixos-build          # build only
#   ./nixos-build switch   # build and switch

set -euo pipefail

cd "$(dirname "$0")"

# NIX_PATH and channels are gross, we ignore them and build up channels of our own
# we only need to do this because home-manager assumes certain channels are present
unset NIX_PATH
NIX_PATH="$(cat "$(nix-build --no-out-link -E '(import ./nix/nix {}).bddap.shitty-nixpath')")"
export NIX_PATH

# Both nix-build and nixos-rebuild find the configuration via <nixos-config>.
NIX_PATH="$NIX_PATH:nixos-config=$(realpath nix/nixos/default.nix)"
NIXPKGS_ALLOW_UNFREE=1

export NIXPKGS_ALLOW_UNFREE
# Unprivileged build first: fails fast before any sudo prompt. No out-link
# — nothing writes into the checkout; the closure's store path goes to
# stdout, which is how install-to-disk consumes it.
nix-build --no-out-link '<nixpkgs/nixos>' -A system

if [ $# -gt 0 ]; then
    # sudo clears env vars
    sudo env \
        NIX_PATH="$NIX_PATH" \
        NIXPKGS_ALLOW_UNFREE="$NIXPKGS_ALLOW_UNFREE" \
        nixos-rebuild "$@"
fi
