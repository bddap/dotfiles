{
  "rules": [
    {
      "paths": ["nix/nix/tts-read/*.py"],
      "tests": ["nix-build nix/nix/default.nix -A bddap.tts-read --no-out-link"],
      "why": "The derivation's check phase runs mypy --strict and the unit tests"
    },
    {
      "paths": ["nix/nixos/sandboxes/**"],
      "tests": [
        "nix-instantiate --parse {path}",
        "nix-build --no-out-link nix/nixos/sandboxes/test.nix -A eval",
        "nix-build --no-out-link nix/nixos/sandboxes/test.nix -A vm"
      ],
      "why": "The sandbox module's option and unit contract is eval-tested; boot, reach, persistence, isolation and rebuild teardown run in a nested-VM NixOS test"
    },
    {
      "paths": [
        "nix/nixos/default.nix",
        "nix/nixos/laptop-hardware.nix",
        "nix/nixos/steam.nix",
        "nix/nixos/laptop-test.nix",
        "nix/nix/default.nix",
        "nix/nix/sources.json"
      ],
      "tests": ["nix-build --no-out-link nix/nixos/laptop-test.nix -A system -A steamEnv"],
      "why": "The laptop modules build into a full system closure and Steam carries the PRIME offload environment"
    },
    {
      "paths": ["nix/**/*.nix"],
      "tests": ["nix-instantiate --parse {path}"],
      "why": "Nix changes must parse before activation"
    },
    {
      "paths": [
        "activate",
        "home-manager-build",
        "install-to-disk",
        "nixos-build",
        "nix/home-manager/root/bin/aspng",
        "nix/home-manager/root/bin/bunch",
        "nix/home-manager/root/bin/capture-soul",
        "nix/home-manager/root/bin/cop",
        "nix/home-manager/root/bin/fmt-python",
        "nix/home-manager/root/bin/next-rustc-err",
        "nix/home-manager/root/bin/onch",
        "nix/home-manager/root/bin/onchs",
        "nix/home-manager/root/bin/paintforme",
        "nix/home-manager/root/bin/pas",
        "nix/home-manager/root/bin/pred",
        "nix/home-manager/root/bin/show-vega",
        "nix/home-manager/root/bin/tmnew",
        "nix/home-manager/root/bin/znew"
      ],
      "tests": ["bash -n {path}"],
      "why": "Shell scripts must parse"
    },
    {
      "paths": [
        "nix/home-manager/root/bin/browser",
        "nix/home-manager/root/bin/cdoc",
        "nix/home-manager/root/bin/csv2json",
        "nix/home-manager/root/bin/json2csv",
        "nix/home-manager/root/bin/tmux-layout-dwindle"
      ],
      "tests": ["python3 -c 'import ast, sys; ast.parse(open(sys.argv[1]).read())' {path}"],
      "why": "Python scripts must parse"
    },
    {
      "paths": [".gitignore", "home/**", "nix/home-manager/zellij/**"],
      "tests": [],
      "why": "Plain config read by each tool at runtime; the repo carries no checker for these formats"
    },
    {
      "paths": ["test-map.json"],
      "tests": ["nix-shell -p jq --run 'jq empty test-map.json'"],
      "why": "The touched-path manifest must remain valid JSON"
    }
  ]
}
