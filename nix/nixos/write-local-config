#!/usr/bin/env bash

# Writes a new machine's nix/nixos/local/ into <local-dir>: a default.nix
# importing each given NixOS module (a file, or a directory with a
# default.nix for one that spans several files).
#
# Usage:
#   write-local-config <local-dir> <hostname> [module...]
#
# A module tracked in this repo is imported in place, so it keeps
# following the repo; any other is copied into <local-dir>, since the new
# machine has no other copy.

set -euo pipefail

if [ $# -lt 2 ]; then
    echo "Usage: $0 <local-dir> <hostname> [module...]" >&2
    exit 1
fi

REPO="$(realpath -e -- "$(dirname "$0")/../..")"
LOCAL="$1"
NEW_HOSTNAME="$2"
shift 2

if ! [[ "$NEW_HOSTNAME" =~ ^[a-z][a-z0-9-]*$ ]]; then
    echo "Error: hostname must match ^[a-z][a-z0-9-]*$" >&2
    exit 1
fi

IMPORTS=()
COPIES=()
for MODULE in "$@"; do
    MODULE="$(realpath -e -- "$MODULE")"
    if [ -d "$MODULE" ] && [ ! -f "$MODULE/default.nix" ]; then
        echo "Error: $MODULE: directory without a default.nix" >&2
        exit 1
    fi
    COPY=no
    if git -c safe.directory="$REPO" -C "$REPO" ls-files --error-unmatch -- "$MODULE" > /dev/null 2>&1; then
        REL="$(realpath -m --relative-to="$REPO/nix/nixos/local" -- "$MODULE")"
    else
        REL="./$(basename "$MODULE")"
        COPY=yes
    fi
    if ! [[ "$REL" =~ ^\.\.?/[A-Za-z0-9._/+-]+$ ]]; then
        echo "Error: $MODULE: not expressible as a Nix path literal" >&2
        exit 1
    fi
    if [ $COPY = yes ]; then
        case " default.nix hardware-configuration.nix ${COPIES[*]##*/} " in
            *" ${REL#./} "*)
                echo "Error: local/${REL#./} is already taken" >&2
                exit 1
                ;;
        esac
        COPIES+=("$MODULE")
    fi
    IMPORTS+=("$REL")
done

mkdir -p "$LOCAL"
for MODULE in "${COPIES[@]}"; do
    cp -a "$MODULE" "$LOCAL/"
done

{
    cat <<NIX
# Host-specific config for ${NEW_HOSTNAME}, gitignored, generated by
# ./install-to-disk. Per-machine tuning goes here.
{ ... }: {
  imports = [
    ../laptop-hardware.nix
    ./hardware-configuration.nix
NIX
    for REL in "${IMPORTS[@]}"; do
        echo "    $REL"
    done
    cat <<NIX
  ];

  networking.hostName = "${NEW_HOSTNAME}";
}
NIX
} > "$LOCAL/default.nix"
