#!/usr/bin/env bash

# Writes a new machine's nix/nixos/local/default.nix, importing each given
# NixOS module (a file, or a directory with a default.nix).
#
# Usage:
#   write-local-config <source-repo> <dest-repo> <hostname> [module...]
#
# A module inside <source-repo> is imported in place from <dest-repo>, so
# it keeps tracking the repo; one outside it is copied into local/, since
# the new machine has no other copy.

set -euo pipefail

if [ $# -lt 3 ]; then
    echo "Usage: $0 <source-repo> <dest-repo> <hostname> [module...]" >&2
    exit 1
fi

SRC="$(realpath -e -- "$1")"
LOCAL="$(realpath -e -- "$2")/nix/nixos/local"
NEW_HOSTNAME="$3"
shift 3

mkdir -p "$LOCAL"

IMPORTS=""
for MODULE in "$@"; do
    MODULE="$(realpath -e -- "$MODULE")"
    case "$MODULE" in
        "$SRC"/*)
            REL="$(realpath -m --relative-to="$SRC/nix/nixos/local" -- "$MODULE")"
            ;;
        *)
            REL="$(basename "$MODULE")"
            if [ -e "$LOCAL/$REL" ] || [ "$REL" = default.nix ]; then
                echo "Error: local/$REL is already taken" >&2
                exit 1
            fi
            cp -a "$MODULE" "$LOCAL/$REL"
            ;;
    esac
    [[ "$REL" == ../* ]] || REL="./$REL"
    if ! [[ "$REL" =~ ^[A-Za-z0-9._/+-]+$ ]]; then
        echo "Error: $MODULE: not expressible as a Nix path literal" >&2
        exit 1
    fi
    IMPORTS+=$'\n'"    $REL"
done

cat > "$LOCAL/default.nix" <<NIX
# Host-specific config for ${NEW_HOSTNAME}, gitignored, generated by
# ./install-to-disk. Per-machine tuning goes here.
{ ... }: {
  imports = [
    ../laptop-hardware.nix
    ./hardware-configuration.nix${IMPORTS}
  ];

  networking.hostName = "${NEW_HOSTNAME}";
}
NIX
