#!/usr/bin/env bash

# Install this NixOS setup onto a new laptop's drive attached to this
# (running) machine, e.g. via a USB dongle.
#
# Usage:
#   sudo ./install-to-disk <hostname> /dev/sdX
#
# What it does:
#   1. Creates nix/nixos/hosts/<hostname>.nix if missing (the per-machine seam)
#   2. Builds the full system closure for that host (disk untouched so far)
#   3. Partitions and formats the target disk with disko
#      (GPT: 1G ESP + LUKS2 ext4 root — see nix/nixos/disko.nix)
#   4. nixos-install --system <closure> --root /mnt
#   5. Sets the password for user `a`
#   6. Copies this repo (including nix/nixos/local/, if present) to
#      /home/a/<repo-dir-name> on the target
#
# Host keys and machine-id are NOT copied — the target generates fresh
# ones on first boot.
#
# After completion: commit nix/nixos/hosts/<hostname>.nix, move the
# drive into the new laptop, boot. Future rebuilds on the new machine:
#   ./nixos-build hosts/<hostname> switch

set -euo pipefail

cd "$(dirname "$0")"

# ── Arguments ───────────────────────────────────────────────────────────

if [ $# -ne 2 ]; then
    echo "Usage: sudo $0 <hostname> /dev/sdX"
    echo ""
    echo "WARNING: This ERASES the target disk entirely."
    exit 1
fi

NEW_HOSTNAME="$1"
DISK="$2"

if [ "$(id -u)" -ne 0 ]; then
    echo "Error: must run as root (sudo $0 $NEW_HOSTNAME $DISK)"
    exit 1
fi

if ! [[ "$NEW_HOSTNAME" =~ ^[a-z][a-z0-9-]*$ ]]; then
    echo "Error: hostname must match ^[a-z][a-z0-9-]*$"
    exit 1
fi

# ── Wrong-target guards ─────────────────────────────────────────────────

if [ ! -b "$DISK" ]; then
    echo "Error: $DISK is not a block device"
    exit 1
fi

# Canonicalize so the ancestor comparison below works for symlinked
# paths like /dev/disk/by-id/... too.
DISK="$(readlink -f -- "$DISK")"

DISK_TYPE="$(lsblk -ndo TYPE "$DISK")"
if [ "$DISK_TYPE" != "disk" ] && [ "$DISK_TYPE" != "loop" ]; then
    echo "Error: $DISK is a $DISK_TYPE, not a whole disk"
    exit 1
fi

# Refuse any disk with mounted filesystems (this alone rules out the
# running system's disk; the ancestor check below is belt-and-braces).
# Guards capture into variables so a failing lsblk aborts (set -e)
# instead of silently passing the check.
DISK_MOUNTS="$(lsblk -no MOUNTPOINTS "$DISK")"
if grep -q . <<< "$DISK_MOUNTS"; then
    echo "Error: $DISK has mounted filesystems:"
    lsblk "$DISK"
    exit 1
fi

# Refuse the disk backing / outright, even if lsblk missed a mount.
ROOT_SRC="$(findmnt -no SOURCE /)"
ROOT_SRC="${ROOT_SRC%%\[*}" # strip btrfs [/subvol] suffix
ROOT_ANCESTORS="$(lsblk -snro NAME "$ROOT_SRC")"
if grep -qx "$(basename "$DISK")" <<< "$ROOT_ANCESTORS"; then
    echo "Error: $DISK backs the running root filesystem"
    exit 1
fi

# Stale mapping from a crashed run (or a name collision) would make
# disko fail after formatting; refuse up front instead.
if [ -e /dev/mapper/cryptroot-install ]; then
    echo "Error: /dev/mapper/cryptroot-install already exists" \
         "(close it or reboot, then retry)"
    exit 1
fi

# ── Confirm ─────────────────────────────────────────────────────────────

echo ""
echo "Target disk:"
lsblk -o NAME,SIZE,TYPE,MODEL,SERIAL "$DISK"
echo ""
echo "ALL DATA ON $DISK WILL BE DESTROYED."
IFS= read -rp "Type the device path ($DISK) to continue: " CONFIRM
if [ "$CONFIRM" != "$DISK" ]; then
    echo "Aborted."
    exit 1
fi

# ── Collect secrets up front (no prompts mid-install) ───────────────────
# IFS= so passphrases with leading/trailing whitespace survive intact.

IFS= read -rsp "LUKS passphrase for the new disk: " LUKS_PASS; echo
IFS= read -rsp "LUKS passphrase (again): " LUKS_PASS2; echo
if [ -z "$LUKS_PASS" ] || [ "$LUKS_PASS" != "$LUKS_PASS2" ]; then
    echo "Error: passphrases empty or mismatched"
    exit 1
fi

IFS= read -rsp "Password for user 'a' on the new machine: " USER_PASS; echo
IFS= read -rsp "Password (again): " USER_PASS2; echo
if [ -z "$USER_PASS" ] || [ "$USER_PASS" != "$USER_PASS2" ]; then
    echo "Error: passwords empty or mismatched"
    exit 1
fi

# ── Host profile (the per-machine seam) ─────────────────────────────────

HOST_FILE="nix/nixos/hosts/${NEW_HOSTNAME}.nix"
if [ ! -f "$HOST_FILE" ]; then
    mkdir -p nix/nixos/hosts
    cat > "$HOST_FILE" <<EOF
# Host profile for ${NEW_HOSTNAME}. Generated by ./install-to-disk.
# Machine-specific tuning (e.g. a nixos-hardware profile) goes here.
{ ... }: {
  imports = [
    ../common.nix
    ../laptop-hardware.nix
  ];

  networking.hostName = "${NEW_HOSTNAME}";
}
EOF
    echo "Created $HOST_FILE — commit it after the install."
fi

# cryptsetup for cleanup, from the pinned nixpkgs (not on PATH everywhere)
CRYPTSETUP="$(nix-build --no-out-link -E '(import ./nix/nix { }).cryptsetup')/bin/cryptsetup"

# ── Step 1: Build the system closure (disk still untouched) ─────────────

echo ""
echo "==> Building the system closure for ${NEW_HOSTNAME}..."

./nixos-build "hosts/${NEW_HOSTNAME}"
SYSTEM="$(readlink -f result)"

echo "System closure built: $SYSTEM"

# ── Cleanup on exit ─────────────────────────────────────────────────────

KEYFILE=""
cleanup() {
    # Keyfile first: nothing below may run before the secret is gone.
    rm -f "$KEYFILE"
    if mountpoint -q /mnt; then
        echo "==> Unmounting /mnt..."
        umount -R /mnt
    fi
    if [ -e /dev/mapper/cryptroot-install ]; then
        "$CRYPTSETUP" close cryptroot-install
    fi
    rm -f result
}
trap cleanup EXIT

# ── Step 2: Partition, format, mount ────────────────────────────────────

echo ""
echo "==> Partitioning and formatting $DISK..."

# Keyfile on tmpfs so the passphrase never touches the installer's disk.
KEYFILE="$(umask 077 && mktemp -p /dev/shm)"
printf '%s' "$LUKS_PASS" > "$KEYFILE"

DISKO_FORMAT_MOUNT="$(nix-build --no-out-link nix/nixos/disko-format-mount.nix \
    --argstr disk "$DISK" --argstr passwordFile "$KEYFILE")"
"$DISKO_FORMAT_MOUNT/bin/disko-format-mount"

if ! mountpoint -q /mnt; then
    echo "Error: /mnt is not mounted after disko. Aborting."
    exit 1
fi

lsblk "$DISK"

# ── Step 3: Install ─────────────────────────────────────────────────────

echo ""
echo "==> Installing NixOS to /mnt..."

nixos-install \
    --root /mnt \
    --system "$SYSTEM" \
    --no-root-password \
    --no-channel-copy

# ── Step 4: Password for user 'a' ───────────────────────────────────────

printf 'a:%s\n' "$USER_PASS" | nixos-enter --root /mnt -c chpasswd

# ── Step 5: Copy this repo (with local modules, if any) to the target ───

REPO_NAME="$(basename "$(pwd)")"
DEST="/mnt/home/a/$REPO_NAME"

echo ""
echo "==> Copying repo to $DEST..."
mkdir -p /mnt/home/a
cp -a "$(pwd)" "$DEST"
# The old machine's hardware config (gitignored) does not apply there.
rm -f "$DEST/nix/nixos/hardware-configuration.nix"
if [ -d nix/nixos/local ]; then
    echo "    (carrying nix/nixos/local/ — local unversioned modules)"
fi
chown -R 1000:100 /mnt/home/a
chmod 700 /mnt/home/a

# ── Done ────────────────────────────────────────────────────────────────

trap - EXIT
cleanup

echo ""
echo "==> Installation complete."
echo ""
echo "Next steps:"
echo "  1. git add $HOST_FILE && git commit   (the new host profile)"
echo "  2. Move the drive into the new laptop and boot."
echo "     (Fresh host keys and machine-id are generated on first boot.)"
echo ""
echo "On the new machine, rebuild with:"
echo "  ./nixos-build hosts/$NEW_HOSTNAME switch"
